# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
API_JSON_LIMIT=64kb
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Backend only. Never expose this in Vite/browser code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
SCANNER_TIMEOUT_MS=8000
SCANNER_REQUEST_DEADLINE_MS=12000
SCANNER_TOTAL_DEADLINE_MS=25000
SCANNER_MAX_CONCURRENT=4
SCANNER_QUEUE_TIMEOUT_MS=5000
SCANNER_MAX_REDIRECTS=3
SCANNER_MAX_RESPONSE_BYTES=524288
SCANNER_ALLOWED_PORTS=80,443
SCAN_RATE_LIMIT_MAX=3
SCAN_RATE_LIMIT_WINDOW_MS=600000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_RETRIES=1
OPENROUTER_RETRY_BASE_DELAY_MS=500
OPENROUTER_RETRY_MAX_DELAY_MS=3000
OPENROUTER_FALLBACK_RETRY_COOLDOWN_MS=60000
OPENROUTER_TEST_ENABLED=false

# Client values belong in client/.env
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
