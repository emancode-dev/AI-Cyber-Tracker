PORT=3000
CLIENT_ORIGIN=http://localhost:5173
API_JSON_LIMIT=64kb

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

SCANNER_TIMEOUT_MS=8000
SCANNER_MAX_REDIRECTS=3
SCANNER_MAX_RESPONSE_BYTES=524288
SCANNER_ALLOWED_PORTS=80,443
SCAN_RATE_LIMIT_MAX=3
SCAN_RATE_LIMIT_WINDOW_MS=600000

# Authorized CLI scanner practice only.
SCANNER_CONFIRM_AUTHORIZED=false
SCANNER_TEST_URL=https://example.com

# Days 28–30 OpenRouter foundation. Never put this key in client/.env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AI Cyber Tracker
OPENROUTER_TEST_ENABLED=true

